# Publication allowlist: game runtime only. Validation also checks the SW manifest.
/*
!/.gitignore
!/.gitattributes
!/README*
!/LICENSE*
!/.github/
!/.github/**
!/index.html
!/sw.js
!/manifest.webmanifest
!/icon-*.png
!/WERSJA.txt
!/JAK_ZAINSTALOWAC.txt
!/assets/
/assets/*
!/assets/*.js
!/assets/*.css
!/assets/*.json
!/assets/*.png
!/assets/*.webp
!/assets/*.avif
!/assets/*.svg
!/assets/*.mp3
!/assets/*.ogg
!/assets/*.woff2
!/assets/three-LICENSE.txt
# Never publish working files, originals, screenshots, archives, or installers.
backup/
test-results/
docs/
tools/
demo-hd2d/
Baza Zawartości/
node_modules/
itch/
**/originals/
**/sources/
**/screenshots/
*.zip
*.7z
*.rar
*.exe
*.msi
*.psd
*.xcf
*.wav
*.aif
*.aiff
*.aup
*.aup3
*.blend
*.kra
*.ora
*.docx
*.xlsx
*.pdf
*.log
.env
.env.*

